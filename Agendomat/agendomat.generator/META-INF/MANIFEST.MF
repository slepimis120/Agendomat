 org.eclipse.xtend.lib;bundle-version="2.42.0",
 com.google.inject;bundle-version="7.0.0",
 org.eclipse.emf.ecore.xmi;bundle-version="2.40.0",
 org.eclipse.sirius;bundle-version="7.5.0",
 agendomat.model;bundle-version="1.0.0",
 org.eclipse.sirius.diagram;bundle-version="7.5.0",
 org.eclipse.core.resources,
 org.eclipse.core.runtime
Automatic-Module-Name: agendomat.generator
Bundle-RequiredExecutionEnvironment: JavaSE-21
