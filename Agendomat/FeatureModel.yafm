<?xml version="1.0" encoding="UTF-8"?>
<fm:featureModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:fm="http://zcu.cz/yafmt/model/fm" name="FeatureModel" version="1.0.0">
  <rootFeature id="featuremodel" name="FeatureModel" lower="1" upper="1">
    <feature id="f_event" name="Event" lower="1" upper="1">
      <feature id="f_eventname" name="EventName" lower="1" upper="1"/>
      <feature id="f_eventdate" name="EventDate" lower="1" upper="1"/>
      <feature id="f_description" name="Description" lower="0" upper="1"/>
      <feature id="f_session" name="Session" lower="1" upper="-1">
        <feature id="f_sessionname" name="SessionName" lower="1" upper="1"/>
        <feature id="f_time" name="Time" lower="1" upper="1">
          <feature id="f_starttime" name="StartTime" lower="1" upper="1"/>
          <feature id="f_endtime" name="EndTime" lower="1" upper="1"/>
        </feature>
        <feature id="f_location" name="Location" lower="1" upper="1"/>
        <feature id="f_presenter" name="Presenter" lower="1" upper="-1"/>
        <feature id="f_techsupport" name="TechSupport" lower="0" upper="-1"/>
        <feature id="f_equipment" name="Equipment" lower="0" upper="-1">
          <feature id="f_equipmentname" name="EquipmentName" lower="1" upper="1"/>
          <feature id="f_equipmenttype" name="EquipmentType" lower="0" upper="1"/>
        </feature>
      </feature>
      <feature id="f_person" name="Person" lower="0" upper="-1">
        <feature id="f_personname" name="PersonName" lower="1" upper="1"/>
        <feature id="f_role" name="Role" lower="1" upper="1"/>
      </feature>
    </feature>
  </rootFeature>
</fm:featureModel>
